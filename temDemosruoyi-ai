[36m@@ -0,0 +1,287 @@[m
[32m+[m[32m# ================================================================[m
[32m+[m[32m# 院前急救通用生理基线配置（极简核心版）[m
[32m+[m[32m# 存放位置：config/acls/GLOBAL/_physiology.yaml[m
[32m+[m[32m# 用途：为所有急救案例提供最基础的生理状态和常用操作效果[m
[32m+[m[32m#       具体案例可在自身 _physiology.yaml 中扩展或覆盖[m
[32m+[m[32m# 设计原则：只包含跨案例共享的通用节点，无任何案例特异性[m
[32m+[m[32m# ================================================================[m
[32m+[m
[32m+[m[32m# 全局默认过渡时间（秒）[m
[32m+[m[32m# 当某个状态未单独指定 transition_duration 时，使用此值[m
[32m+[m[32m# 该时间表示模拟器从当前状态自然过渡到下一个状态所需的时间[m
[32m+[m[32mdefault_transition_duration: 10[m
[32m+[m
[32m+[m[32m# ================================================================[m
[32m+[m[32m# 状态生理基线定义[m
[32m+[m[32m# 每个键代表一个逻辑状态，其下的数值为"学员未做干预时的自然病程"[m
[32m+[m[32m# 学员的操作（给药、电击、CPR等）将作为动态叠加层影响最终显示值[m
[32m+[m[32m# ================================================================[m
[32m+[m[32mstate_physiology:[m
[32m+[m
[32m+[m[32m  # ----- 初始评估 / 分诊 -----[m
[32m+[m[32m  # 场景：刚接触患者时的首次生命体征采集[m
[32m+[m[32m  # 通常用于所有案例的起始节点[m
[32m+[m[32m  GLOBAL-ASSESS:[m
[32m+[m[32m    phys.heartRate: 80          # 心率 (次/分)[m
[32m+[m[32m    phys.systolicBp: 120        # 收缩压 (mmHg)[m
[32m+[m[32m    phys.diastolicBp: 80        # 舒张压 (mmHg)[m
[32m+[m[32m    phys.spo2: 98               # 血氧饱和度 (%)[m
[32m+[m[32m    phys.respiratoryRate: 16    # 呼吸频率 (次/分)[m
[32m+[m[32m    phys.consciousness: "alert" # 意识状态：alert（清醒）, verbal（对声音有反应）, pain（对疼痛有反应）, unresponsive（无反应）[m
[32m+[m[32m    transition_duration: 5      # 此状态持续5秒后自动进入下一状态（如无操作）[m
[32m+[m
[32m+[m[32m  # ----- 稳定状态 -----[m
[32m+[m[32m  # 场景：患者生命体征正常，无危及生命情况[m
[32m+[m[32m  # 常见于成功干预后的稳定期，或初始病情轻微[m
[32m+[m[32m  GLOBAL-STABLE:[m
[32m+[m[32m    phys.heartRate: 75[m
[32m+[m[32m    phys.systolicBp: 125[m
[32m+[m[32m    phys.diastolicBp: 82[m
[32m+[m[32m    phys.spo2: 99[m
[32m+[m[32m    phys.respiratoryRate: 14[m
[32m+[m[32m    phys.consciousness: "alert"[m
[32m+[m[32m    # 未指定 transition_duration，将使用全局默认值 10 秒[m
[32m+[m
[32m+[m[32m  # ----- 不稳定状态 -----[m
[32m+[m[32m  # 场景：患者出现休克、低血压、意识改变等危急征象[m
[32m+[m[32m  # 此状态用于触发紧急干预流程（如液体复苏、血管活性药物等）[m
[32m+[m[32m  GLOBAL-UNSTABLE:[m
[32m+[m[32m    phys.heartRate: 130[m
[32m+[m[32m    phys.systolicBp: 85[m
[32m+[m[32m    phys.diastolicBp: 50[m
[32m+[m[32m    phys.spo2: 92[m
[32m+[m[32m    phys.respiratoryRate: 28[m
[32m+[m[32m    phys.consciousness: "confused"  # 意识模糊，常见于脑灌注不足[m
[32m+[m[32m    transition_duration: 8[m
[32m+[m
[32m+[m[32m  # ----- 心脏骤停 -----[m
[32m+[m[32m  # 场景：无脉搏、无呼吸，心电呈直线（Asystole）或室颤/无脉性室速[m
[32m+[m[32m  # 血压和血氧均为 0，意识无反应[m
[32m+[m[32m  GLOBAL-CARDIAC_ARREST:[m
[32m+[m[32m    phys.heartRate: 0[m
[32m+[m[32m    phys.systolicBp: 0[m
[32m+[m[32m    phys.diastolicBp: 0[m
[32m+[m[32m    phys.spo2: 0[m
[32m+[m[32m    phys.respiratoryRate: 0[m
[32m+[m[32m    phys.consciousness: "unresponsive"[m
[32m+[m
[32m+[m[32m  # ----- CPR 进行中 -----[m
[32m+[m[32m  # 场景：学员正在进行胸外按压和人工通气[m
[32m+[m[32m  # 此时虽无自主循环，但按压可产生一定的血流（约 60/30 mmHg）[m
[32m+[m[32m  # 血氧因通气有所改善（约 85%）[m
[32m+[m[32m  GLOBAL-CPR:[m
[32m+[m[32m    phys.heartRate: 0           # 仍无自主心率[m
[32m+[m[32m    phys.systolicBp: 60         # 按压产生的收缩压[m
[32m+[m[32m    phys.diastolicBp: 30[m
[32m+[m[32m    phys.spo2: 85[m
[32m+[m[32m    phys.respiratoryRate: 10    # 人工通气频率（通常按压通气比为 30:2）[m
[32m+[m[32m    phys.consciousness: "unresponsive"[m
[32m+[m[32m    transition_duration: 30     # 此状态持续30秒，需学员持续操作[m
[32m+[m
[32m+[m[32m  # ----- 恢复自主循环 (ROSC) -----[m
[32m+[m[32m  # 场景：经CPR和/或电击后患者自主心跳恢复[m
[32m+[m[32m  # 常见于成功除颤或用药后，是急救成功的关键转折点[m
[32m+[m[32m  GLOBAL-ROSC:[m
[32m+[m[32m    phys.heartRate: 100[m
[32m+[m[32m    phys.systolicBp: 110[m
[32m+[m[32m    phys.diastolicBp: 70[m
[32m+[m[32m    phys.spo2: 96[m
[32m+[m[32m    phys.respiratoryRate: 18[m
[32m+[m[32m    phys.consciousness: "confused"  # ROSC后早期常存在脑功能不全，意识可能未完全恢复[m
[32m+[m[32m    transition_duration: 20[m
[32m+[m
[32m+[m[32m  # ----- 常规监测 -----[m
[32m+[m[32m  # 场景：患者情况稳定，进入观察期[m
[32m+[m[32m  # 此状态可作为急救后期或转运前的基线[m
[32m+[m[32m  GLOBAL-MONITORING:[m
[32m+[m[32m    phys.heartRate: 78[m
[32m+[m[32m    phys.systolicBp: 122[m
[32m+[m[32m    phys.diastolicBp: 78[m
[32m+[m[32m    phys.spo2: 99[m
[32m+[m[32m    phys.respiratoryRate: 15[m
[32m+[m[32m    phys.consciousness: "alert"[m
[32m+[m[32m    transition_duration: 25[m
[32m+[m
[32m+[m[32m  # ----- 退出案例 -----[m
[32m+[m[32m  # 场景：患者已稳定或终止抢救，退出当前模拟案例[m
[32m+[m[32m  # 常作为整个流程的终止节点[m
[32m+[m[32m  GLOBAL-EXIT:[m
[32m+[m[32m    phys.heartRate: 75[m
[32m+[m[32m    phys.systolicBp: 120[m
[32m+[m[32m    phys.diastolicBp: 80[m
[32m+[m[32m    phys.spo2: 99[m
[32m+[m[32m    phys.respiratoryRate: 14[m
[32m+[m[32m    phys.consciousness: "alert"[m
[32m+[m[32m    transition_duration: 10[m
[32m+[m
[32m+[m[32m# ================================================================[m
[32m+[m[32m# 操作效果定义（系统运行时根据学员操作动态叠加）[m
[32m+[m[32m# 每个操作可影响多个生理指标，并指定作用时长、恢复方式和曲线类型[m
[32m+[m[32m# 所有操作效果均为通用定义，具体案例可在此基础上调整参数[m
[32m+[m[32m# ================================================================[m
[32m+[m[32moperation_effects:[m
[32m+[m
[32m+[m[32m  # ----- 肾上腺素（EPINEPHRINE）-----[m
[32m+[m[32m  # 用途：心脏骤停、过敏性休克、严重低血压[m
[32m+[m[32m  # 作用：收缩血管（升压）、增加心输出量，轻微增快心率[m
[32m+[m[32m  EPINEPHRINE:[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: 25                # 收缩压上升 25 mmHg[m
[32m+[m[32m      duration: 20             # 作用维持 20 秒（随后开始恢复）[m
[32m+[m[32m      recovery: 15             # 恢复期 15 秒（完全回到基线）[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER  # 线性衰减再线性恢复[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: 20                # 心率增加 20 次/分[m
[32m+[m[32m      duration: 15[m
[32m+[m[32m      recovery: 10[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- 阿托品（ATROPINE）-----[m
[32m+[m[32m  # 用途：症状性心动过缓（如迷走反射、房室传导阻滞）[m
[32m+[m[32m  # 作用：阻断迷走神经，增快心率，轻度升压[m
[32m+[m[32m  ATROPINE:[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: 30                # 心率增快 30 次/分[m
[32m+[m[32m      duration: 25[m
[32m+[m[32m      recovery: 20[m
[32m+[m[32m      curve: INSTANT_DROP_LINEAR_RECOVER  # 瞬时起效，线性恢复[m
[32m+[m
[32m+[m[32m  # ----- 胺碘酮（AMIODARONE）-----[m
[32m+[m[32m  # 用途：室性心律失常（如室速、室颤）及房颤的转复[m
[32m+[m[32m  # 作用：减慢心率，轻度降压（扩血管作用）[m
[32m+[m[32m  AMIODARONE:[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: -20               # 心率减慢 20 次/分[m
[32m+[m[32m      duration: 30[m
[32m+[m[32m      recovery: 25[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: -10               # 收缩压下降 10 mmHg（可能需配合升压药）[m
[32m+[m[32m      duration: 20[m
[32m+[m[32m      recovery: 15[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- 多巴胺（DOPAMINE）-----[m
[32m+[m[32m  # 用途：各种休克状态（心源性、分布性、低血容量性）[m
[32m+[m[32m  # 作用：剂量依赖性升压（正性肌力+缩血管），心率轻度增快[m
[32m+[m[32m  DOPAMINE:[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: 30                # 收缩压上升 30 mmHg[m
[32m+[m[32m      duration: 30[m
[32m+[m[32m      recovery: 20[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: 15                # 心率增加 15 次/分[m
[32m+[m[32m      duration: 20[m
[32m+[m[32m      recovery: 15[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- 利多卡因（LIDOCAINE）-----[m
[32m+[m[32m  # 用途：室性心律失常（尤其急性心肌梗死合并室早/室速）[m
[32m+[m[32m  # 作用：抑制心室异位节律，轻微减慢心率[m
[32m+[m[32m  LIDOCAINE:[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: -15               # 心率减慢 15 次/分[m
[32m+[m[32m      duration: 20[m
[32m+[m[32m      recovery: 15[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- 除颤（DEFIBRILLATION）-----[m
[32m+[m[32m  # 用途：室颤（VF）或无脉性室速（pVT）——同步电复律[m
[32m+[m[32m  # 作用：释放电能除颤，使心律转为窦性，心率下降，血压回升[m
[32m+[m[32m  # 通常配合 200J 双相波[m
[32m+[m[32m  DEFIBRILLATION:[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: -150              # 心率骤降（转为窦性后正常）[m
[32m+[m[32m      duration: 5              # 效果几乎瞬时[m
[32m+[m[32m      recovery: 10             # 稳定后逐步恢复至基线[m
[32m+[m[32m      curve: INSTANT_DROP_LINEAR_RECOVER[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: 40                # 除颤成功后灌注改善，血压上升[m
[32m+[m[32m      duration: 15[m
[32m+[m[32m      recovery: 10[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- 同步电复律（CARDIOVERSION）-----[m
[32m+[m[32m  # 用途：不稳定型房颤/房扑、室上性心动过速（血流动力学不稳定）[m
[32m+[m[32m  # 作用：与R波同步释放能量，转复为窦性，心率下降，血压稳定[m
[32m+[m[32m  CARDIOVERSION:[m
[32m+[m[32m    - target: phys.heartRate[m
[32m+[m[32m      delta: -80               # 心率下降（通常转复后心率减慢）[m
[32m+[m[32m      duration: 5[m
[32m+[m[32m      recovery: 15[m
[32m+[m[32m      curve: INSTANT_DROP_LINEAR_RECOVER[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: 30                # 转复后心输出量改善，血压上升[m
[32m+[m[32m      duration: 20[m
[32m+[m[32m      recovery: 15[m
[32m+[m[32m      curve: LINEAR_DECAY_LINEAR_RECOVER[m
[32m+[m
[32m+[m[32m  # ----- CPR 持续进行（CPR_ONGOING）-----[m
[32m+[m[32m  # 用途：在心脏骤停时，按压可产生一定灌注[m
[32m+[m[32m  # 作用：维持冠脉和脑灌注，提高除颤成功率和ROSC几率[m
[32m+[m[32m  # 此效果通常叠加在 CPR 状态下，且恢复期为 0（按压停止即效果消失）[m
[32m+[m[32m  CPR_ONGOING:[m
[32m+[m[32m    - target: phys.systolicBp[m
[32m+[m[32m      delta: 50                # 按压产生的收缩压增量[m
[32m+[m[32m      duration: 30             # 效果持续按压期间[m
[32m+[m[32m      recovery: 0              # 按压停止立刻恢复（无延迟）[m
[32m+[m[32m      curve: CONSTANT          # 恒值，不衰减[m
[32m+[m[32m    - target: phys.spo2[m
[32m+[m[32m      delta: 10                # 人工通气改善氧合[m
[32m+[m[32m      duration: 30[m
[32m+[m[32m      recovery: 0[m
[32m+[m[32m      curve: CONSTANT[m
[32m+[m
[32m+[m[32m  # ----- 气管插管 / 机械通气（INTUBATION）-----[m
[32m+[m[32m  # 用途：建立高级气道，保证通气和氧合[m
[32m+[m[32m  # 作用：提高血氧饱和度，降低呼吸频率（由呼吸机控制）[m
[32m+[m[32m  INTUBATION:[m
[32m+[m[32m    - target: phys.spo2[m
[32m+[m[32m      delta: 5                 # 血氧上升 5%[m
[32m+[m[32m      duration: 30[m
[32m+[m[32m      recovery: 10[m
