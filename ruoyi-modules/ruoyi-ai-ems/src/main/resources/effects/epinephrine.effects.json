{
  "id": "epinephrine-effect-mapping",
  "version": "1.0-aha2025-aligned",
  "status": "pending_clinical_signoff",
  "upstream": "ACLS-TUTOR-DESIGN-VIRTUAL-PATIENT-V0.2-candidate",
  "guideline": "AHA 2025 Guidelines for CPR and ECC, Adult ALS",
  "generatedAt": "2026-09-24",

  "actionMatcher": {
    "type": "drug_push",
    "drug": "epinephrine",
    "concentration": "1mg/10mL (1:10,000)",
    "adminNote": "rapid IV/IO bolus, follow with 20 mL NS flush; administer every 3-5 min during arrest"
  },

  "_notes": [
    "病人永远诚实：模型不阻断、不拦截、不评判。所有操作均产生生理反应。",
    "评审信号仅由独立评审层消费，不改变病人模型效应。",
    "肾上腺素推荐剂量：1mg IV/IO，每3-5分钟重复，无最大剂量限制。",
    "可除颤心律（VF/pVT）：第2次电击后给予首剂；不可除颤心律（PEA/Asystole）：建立通路后尽早给予。",
    "AHA 2025 强烈不推荐高剂量肾上腺素（>1mg），因神经预后和生存率更差。",
    "肥胖患者使用与非肥胖患者相同的标准剂量。",
    "intervention.epinephrine.* 为对象子键，需确认 DSL 是否支持对象属性路径。",
    "肾上腺素在心脏骤停中无体重剂量调整。"
  ],

  "sideEffectProfiles": {
    "EPI-SE-COMMON": {
      "description": "肾上腺素常见并行副作用。半衰期<5分钟，起效1-2分钟。",
      "effects": [
        { "target": "phys.heartRate", "op": "delta", "value": 20, "durationMs": 5000, "note": "心动过速" },
        { "target": "phys.systolicBp", "op": "delta", "value": 30, "durationMs": 10000, "note": "高血压" },
        { "target": "phys.anxiety", "op": "set", "value": true },
        { "target": "phys.diaphoresis", "op": "set", "value": true },
        { "target": "phys.chestPain", "op": "set", "value": true, "note": "心绞痛" },
        { "eventTag": "epinephrine_palpitations", "note": "心悸" },
        { "eventTag": "epinephrine_pallor", "note": "苍白" },
        { "eventTag": "epinephrine_ventricular_ectopy", "note": "室性早搏" }
      ]
    },
    "EPI-SE-HIGH-DOSE": {
      "description": "高剂量肾上腺素（>1mg）副作用 — AHA 2025 强烈不推荐。",
      "effects": [
        { "target": "phys.heartRate", "op": "delta", "value": 40, "durationMs": 10000 },
        { "target": "phys.systolicBp", "op": "delta", "value": 60, "durationMs": 15000 },
        { "eventTag": "epinephrine_cerebral_hemorrhage_risk", "note": "高血压脑出血风险" },
        { "eventTag": "epinephrine_worsened_neurologic_outcome", "note": "神经预后恶化" }
      ]
    }
  },

