  "actionMatcher": {
    "type": "drug_push",
    "drug": "adenosine",
    "adminNote": "rapid IV push over 1-3sec, follow each dose with 20 mL NS flush, elevate arm"
  },

  "_notes": [
    "病人永远诚实：模型不阻断、不拦截、不评判。所有操作均产生生理反应。",
    "评审信号仅由独立评审层消费，不改变病人模型效应。",
    "首剂6mg成功率参考值52%，第二剂12mg累计成功率83%；12mg首剂成功率83%[reference:1][reference:2]。病例脚本可锁定成功/失败。",
    "intervention.adenosine.* 为对象子键，需确认 DSL 是否支持对象属性路径。",
    "AVNRT/AVRT 归入 phys.rhythm == 'SVT'；MAT 当前无枚举。",
    "宽 QRS 判断用 phys.qrsDuration >= 0.12，不用 derived.qrsWidth。",
    "潮红、头痛、喉颈下颌不适、一过性完全性AVB 当前无结构化字段，暂用事件标签。",
    "哮喘、心脏移植、病态窦房结、AVB、药物相互作用、体重当前无结构化字段，列入 extensions。"
  ],

  "sideEffectProfiles": {
    "ADN-SE-COMMON": {
      "description": "腺苷常见并行副作用。AHA 2025: 腺苷半衰期<10秒，副作用通常<60秒内消退。",
      "effects": [
        { "target": "phys.chestPain", "op": "set", "value": true, "note": "胸痛/胸闷" },
        { "target": "phys.shortnessOfBreath", "op": "set", "value": true, "note": "呼吸困难" },
        { "target": "phys.nausea", "op": "set", "value": true, "note": "恶心" },
        { "target": "phys.diaphoresis", "op": "set", "value": true, "note": "大汗" },
        { "target": "phys.anxiety", "op": "set", "value": true, "note": "焦虑/濒死感" },
        { "target": "phys.systolicBp", "op": "delta", "value": -15, "durationMs": 3000 },
        { "eventTag": "adenosine_flushing", "note": "面部潮红 — phys.flushing 字段缺失，暂用事件标签" },
        { "eventTag": "adenosine_headache", "note": "头痛 — phys.headache 字段缺失" },
        { "eventTag": "adenosine_throat_neck_discomfort", "note": "喉/颈/下颌不适 — 字段缺失" },
        { "eventTag": "adenosine_transient_av_block", "note": "一过性完全性AVB — phys.transientCompleteAvBlock 字段缺失" }
      ]
    },
    "ADN-SE-ASTHMA": {
      "description": "哮喘患者腺苷副作用 — 支气管痉挛。AHA 2025: 腺苷在哮喘患者中为禁忌。[reference:3]",
      "effects": [
        { "target": "phys.shortnessOfBreath", "op": "set", "value": true },
        { "target": "phys.spo2", "op": "delta", "value": -10, "durationMs": 120000 },
        { "target": "phys.respiratoryRate", "op": "delta", "value": 10, "durationMs": 120000 },
        { "eventTag": "adenosine_bronchospasm", "note": "严重支气管痉挛" }
      ]
    }
  },

