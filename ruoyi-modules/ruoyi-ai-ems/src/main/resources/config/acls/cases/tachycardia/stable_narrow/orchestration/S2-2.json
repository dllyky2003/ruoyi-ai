{
  "intent_code": "S2-2",
  "act_type": "发令性指令",
  "name_cn": "腺苷推注执行",
  "description_cn": "快速静脉推注腺苷，用于终止规则性窄QRS心动过速。首剂6mg，次剂12mg",
  "keywords": ["腺苷推注", "快速静推", "首剂腺苷", "次剂腺苷"],
  "pattern_hints": ["推腺苷", "再推一支", "静推腺苷"],
  "examples": [
    "腺苷6毫克快速静推",
    "腺苷12毫克再推一次",
    "推腺苷",
    "首剂腺苷快推",
    "再推一支腺苷"
  ],
  "standard_script": "准备腺苷6mg快速静推，推完立即冲20ml生理盐水。",
  "extraction": {
    "target_params": ["drug", "dose", "dose_sequence", "operation_status"],
    "rules": {
      "drug": { "type": "string", "static": "adenosine" },
      "dose_sequence": {
        "type": "string",
        "enum": ["first", "second", "unknown"]
      },
      "dose": { "type": "string", "source": "numeric_value", "unit": "mg" },
      "operation_status": {
        "type": "string",
        "enum": ["done", "start", "pending"]
      }
    }
  },
  "execution": {
    "type": "action_chain",
    "steps": [
      { "step_id": "iv_push_adenosine", "ref_atomic": "IV_PUSH", "duty": "IV_MED" },
      { "step_id": "flush_line", "ref_atomic": "FLUSH_LINE", "duty": "IV_MED" }
    ],
    "preconditions": {
      "flush_line": ["iv_push_adenosine"]
    },
    "on_complete": {
      "response_template": "💉 快速静推 {dose} {drug}，冲管完成。",
      "transition_event": "S2-2_DONE"
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "💉 正在快速静推 {dose} {drug}，冲管中。"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 腺苷推注状态：{operation_status}。"
    },
    "策略纠偏/否决": {
      "action": "abort_chain",
      "response_template": "🛑 已中止腺苷推注。"
    }
  }
}
