{
  "intent_code": "S2-8",
  "act_type": "宣告",
  "name_cn": "治疗结果报告",
  "description_cn": "报告药物或电击干预后的结果，如转复成功、未转复、无效等",
  "keywords": ["转复为窦性", "未转复", "转复成功", "无效"],
  "pattern_hints": ["转复成功", "恢复了窦性心律"],
  "examples": [
    "转复为窦性",
    "未转复",
    "仍未转复",
    "转复成功",
    "无效",
    "转复为房颤",
    "恢复了窦性心律"
  ],
  "standard_script": "心律已转复为窦性，血压稳定。",
  "extraction": {
    "target_params": ["vagal_effect_observed", "rhythm_confirmed"],
    "rules": {
      "vagal_effect_observed": {
        "type": "string",
        "enum": ["success", "failure", "partial"]
      },
      "rhythm_confirmed": {
        "type": "string",
        "enum": ["sinus", "afib", "aflutter", "svt", "vt", "unknown"]
      }
    }
  },
  "execution": {
    "type": "atomic",
    "response_template": "📋 治疗结果：{vagal_effect_observed}，心律 {rhythm_confirmed}。",
    "requires_state_transition": true,
    "transition_event": "S2-8_DONE"
  },
  "pragmatic_handlers": {
    "宣告": {
      "action": "execute_action",
      "response_template": "📋 治疗结果：{vagal_effect_observed}，心律 {rhythm_confirmed}。"
    },
    "探查性询问": {
      "action": "query_context",
      "response_template": "📋 治疗结果待确认..."
    }
  }
}
