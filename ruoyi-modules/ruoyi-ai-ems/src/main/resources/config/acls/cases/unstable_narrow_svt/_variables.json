{
  "caseType": "unstable_narrow_svt",
  "description": "窄QRS不稳定/SVT案例专属变量（含同步电复律前镇静）。此文件只包含本案例使用的变量，通用 ACLS 变量在 GLOBAL/_variables.json。派生规则见同目录 _derivations.yaml。",

  "resetDefaults": {
    "intervention.sedation": {
      "status": null,
      "given": false,
      "drug": null,
      "dose": null,
      "lastTime": null
    },
    "process.sedationAssessed": false,
    "process.cardioversionWithoutSedation": false,
    "process.stepSyncModeRequested": false,
    "process.stepEnergySelected": false,
    "process.stepSedationGiven": false,
    "process.stepDefibCharged": false,
    "process.stepClearAnnounced": false,
    "process.emergencyCardioversionPerformed": false,

    "phys.rhythm": "SVT",
    "phys.systolicBp": 88,
    "phys.heartRate": 175,
    "phys.spo2": 94,
    "phys.respiratoryRate": 28,
    "phys.consciousness": "verbal"
  },

  "variables": [
    {
      "name": "intervention.sedation",
      "name_cn": "镇静记录",
      "type": "object",
      "description": "status（given/failed/cancelled）、given、drug、dose、lastTime",
      "category": "TREATMENT_HISTORY",
      "source": "EXECUTOR",
      "writable_by": "EXECUTOR,PARAM_EXTRACTOR",
      "requiredKeys": ["status", "given"],
      "default_value": {
        "status": null,
        "given": false,
        "drug": null,
        "dose": null,
        "lastTime": null
      },
      "persistence": true,
      "scoring": true
    },
    {
      "name": "process.sedationAssessed",
      "name_cn": "镇静评估已完成",
      "type": "boolean",
      "description": "是否已对镇静需求/禁忌进行评估",
      "category": "PROCESS_MARKER",
      "source": "EXECUTOR",
      "writable_by": "EXECUTOR,PARAM_EXTRACTOR",
      "default_value": false,
      "persistence": true,
      "scoring": true
    },
    {
      "name": "process.cardioversionWithoutSedation",
      "name_cn": "未镇静即电复律",
      "type": "boolean",
      "description": "是否在未给予镇静的情况下执行了同步电复律（用于评分/告警）",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": true
    },
    {
      "name": "process.stepSyncModeRequested",
      "name_cn": "步骤：已请求开启同步模式",
      "type": "boolean",
      "description": "状态机步骤标记。仅由 transition effects 写入。用于让 F-102-PREP_CARDIOVERSION 的 Guard 保持事前语义。与 device.defibSyncMode 解耦。",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": false
    },
    {
      "name": "process.stepEnergySelected",
      "name_cn": "步骤：已选择能量",
      "type": "boolean",
      "description": "状态机步骤标记。仅由 transition effects 写入。",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": false
    },
    {
      "name": "process.stepSedationGiven",
      "name_cn": "步骤：已给予镇静",
      "type": "boolean",
      "description": "状态机步骤标记。仅由 transition effects 写入。",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": false
    },
    {
      "name": "process.stepDefibCharged",
      "name_cn": "步骤：已充电",
      "type": "boolean",
      "description": "状态机步骤标记。仅由 transition effects 写入。",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": false
    },
    {
      "name": "process.stepClearAnnounced",
      "name_cn": "步骤：已宣布清场",
      "type": "boolean",
      "description": "状态机步骤标记。仅由 transition effects 写入。",
      "category": "PROCESS_MARKER",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": false
    },
    {
      "name": "process.emergencyCardioversionPerformed",
      "name_cn": "已执行紧急同步电复律",
      "type": "boolean",
      "description": "本案例是否为血流动力学不稳定而执行的紧急同步电复律（区别于择期电复律）。由 deliver_sync_shock 技能或 LLM 抽取写入。",
      "category": "PROCESS_MARKER",
      "source": "EXECUTOR",
      "writable_by": "EXECUTOR,PARAM_EXTRACTOR,SYSTEM",
      "default_value": false,
      "persistence": true,
      "scoring": true
    },
    {
      "name": "derived.unstable",
      "name_cn": "派生血流动力学不稳定",
      "type": "boolean",
      "description": "由 5 个不稳定征象派生的反向标记，等价于 derived.stable == false",
      "category": "DERIVED",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": null,
      "value_labels": {
        "true": "不稳定",
        "false": "稳定"
      }
    },
    {
      "name": "derived.isUnstableNarrowQrs",
      "name_cn": "派生不稳定窄QRS",
      "type": "boolean",
      "description": "是否满足血流动力学不稳定 + 窄QRS，是进入紧急同步电复律分支的核心条件",
      "category": "DERIVED",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": null,
      "value_labels": {
        "true": "不稳定窄QRS",
        "false": "不满足"
      }
    },
    {
      "name": "derived.cardioversionReady",
      "name_cn": "派生电复律就绪",
      "type": "boolean",
      "description": "同步电复律启动条件是否全部就绪：不稳定窄QRS + 除颤仪同步模式 + 已充电 + 已清场",
      "category": "DERIVED",
      "source": "SYSTEM",
      "writable_by": "SYSTEM",
      "default_value": null,
      "value_labels": {
        "true": "就绪",
        "false": "未就绪"
      }
    }
  ],

  "slot_mappings": {
    "description": "镇静相关槽位映射（仅案例专属部分，通用映射在 GLOBAL/_variables.json）",
    "mappings": {
      "sedation_given": "intervention.sedation.given",
      "sedation_drug": "intervention.sedation.drug",
      "sedation_dose": "intervention.sedation.dose",
      "sedation_assessed": "process.sedationAssessed",
      "cardioversion_without_sedation": "process.cardioversionWithoutSedation"
    }
  }
}
