{
  "intent_code": "S2-6",
  "act_type": "发令性指令",
  "name_cn": "同步电复律序列执行",
  "description_cn": "执行同步电复律，包括：设置同步模式、选择能量、充电、清场、放电、复评。",
  "keywords": ["同步电复律", "调成同步模式", "准备放电", "焦耳充电"],
  "pattern_hints": ["同步模式充电", "准备放电"],
  "examples": [
    "调成同步模式100焦耳充电",
    "同步电复律100焦耳准备放电"
  ],
  "standard_script": "调至同步模式，选择能量100J，充电，清场，放电，复评。",

  "extraction": {
    "target_params": ["procedure", "energy", "operation_status", "sedation"],
    "rules": {
      "procedure": { "type": "string", "static": "cardioversion" },
      "energy": { "type": "string", "source": "numeric_value", "unit": "J" },
      "operation_status": { "type": "string", "enum": ["prep", "charging", "done"] },
      "sedation": { "type": "string", "enum": ["midazolam", "etomidate", "fentanyl", "none"] }
    }
  },

  "execution": {
    "type": "action_chain",
    "description": "同步电复律完整动作链",
    "steps": [
      { "step_id": "prep_sedation", "ref_atomic": "PREPARE_SYRINGE", "duty": "IV_MED" },
      { "step_id": "set_sync", "ref_atomic": "SET_SYNC_MODE", "duty": "MONITOR_DEFIB" },
      { "step_id": "select_energy", "ref_atomic": "SELECT_ENERGY", "duty": "MONITOR_DEFIB" },
      { "step_id": "charge", "ref_atomic": "CHARGE_DEFIB", "duty": "MONITOR_DEFIB" },
      { "step_id": "safety_clear", "ref_atomic": "CLEAR_BEDSIDE", "duty": "ASSIST" },
      { "step_id": "discharge", "ref_atomic": "DISCHARGE_SHOCK", "duty": "MONITOR_DEFIB" },
      { "step_id": "reassess", "ref_atomic": "REASSESS", "duty": "ASSESS" }
    ],
    "preconditions": {
      "discharge": ["charge", "safety_clear"],
      "select_energy": ["set_sync"],
      "set_sync": ["prep_sedation"],
      "charge": ["select_energy"],
      "reassess": ["discharge"]
    },
    "on_complete": {
      "transition_event": "S2-6_DONE",
      "response_template": "⚡ 同步电复律序列完成"
    },
    "on_error": {
      "fallback_intent": "S4-4",
      "response_template": "⚠️ 电复律流程中断，请检查"
    }
  },

  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "⚡ 正在执行 {current_step}"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 {step_id} 状态: {status}"
    },
    "策略纠偏/否决": {
      "action": "abort_chain",
      "response_template": "🛑 已中止电复律流程"
    }
  },

  "execution_legacy": {
    "target_duty": "MONITOR_DEFIB",
    "action_type": "CARDIOVERSION",
    "response_template": "⚡ {executor_name} 正在执行同步电复律 {energy}，镇静：{sedation}，状态：{operation_status}。",
    "requires_state_transition": true,
    "transition_event": "S2-6_DONE",
    "estimated_duration_seconds": 10
  }
}
