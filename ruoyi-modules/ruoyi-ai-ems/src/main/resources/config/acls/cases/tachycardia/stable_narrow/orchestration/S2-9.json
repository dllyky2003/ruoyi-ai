{
  "intent_code": "S2-9",
  "act_type": "探查性询问",
  "name_cn": "抗凝评估与决策",
  "description_cn": "针对房颤/房扑等心律不齐患者，评估CHADS2-VASc评分及抗凝指征",
  "keywords": ["评估抗凝", "CHADS2评分", "需要抗凝吗"],
  "pattern_hints": ["抗凝指征", "抗凝禁忌"],
  "examples": [
    "评估抗凝指征",
    "准备抗凝治疗",
    "CHADS2评分多少",
    "患者需要抗凝吗",
    "有没有抗凝禁忌"
  ],
  "standard_script": "评估CHADS2-VASc评分，患者需要抗凝吗？有无禁忌？",
  "extraction": {
    "target_params": ["anticoagulant", "decision"],
    "rules": {
      "anticoagulant": {
        "type": "string",
        "enum": ["heparin", "warfarin", "NOAC", "none"]
      },
      "decision": {
        "type": "string",
        "enum": ["start", "defer", "contraindicated"]
      }
    }
  },
  "execution": {
    "type": "query",
    "response_template": "📋 抗凝评估：{anticoagulant}，决策：{decision}。",
    "data_source": "context"
  },
  "pragmatic_handlers": {
    "探查性询问": {
      "action": "query_context",
      "response_template": "📋 抗凝评估：{anticoagulant}，决策：{decision}。"
    },
    "发令性指令": {
      "action": "execute_action",
      "response_template": "📋 正在评估抗凝指征..."
    }
  }
}
