{
  "intent_code": "S1-1",
  "act_type": "探查性询问",
  "name_cn": "QRS宽度判读指令",
  "description_cn": "要求确认心电图QRS波群时限是否≤0.12秒，以区分窄QRS与宽QRS心动过速",
  "keywords": ["QRS宽吗", "窄QRS吗", "QRS时限多少", "量QRS宽度"],
  "pattern_hints": ["是窄QRS吗", "QRS超过多少"],
  "examples": [
    "看看心电图QRS宽吗",
    "是窄QRS吗",
    "QRS时限多少",
    "量一下QRS宽度",
    "不是窄QRS是宽的",
    "QRS超过0.14秒了"
  ],
  "standard_script": "看看心电图，QRS波群时限是多少？是窄QRS还是宽QRS？",
  "extraction": {
    "target_params": ["asserted_qrs_width"],
    "rules": {
      "asserted_qrs_width": {
        "type": "string",
        "enum": ["narrow", "wide"],
        "logic": "若出现'窄QRS'、'<0.12'、'不宽'、'QRS正常' → 'narrow'；若出现'宽QRS'、'>0.12'、'超过0.12'、'宽的' → 'wide'"
      }
    }
  },
  "execution": {
    "type": "query",
    "response_template": "📋 QRS宽度判读：{asserted_qrs_width}。",
    "data_source": "context"
  },
  "pragmatic_handlers": {
    "探查性询问": {
      "action": "query_context",
      "response_template": "📋 QRS宽度判读：{asserted_qrs_width}。"
    },
    "发令性指令": {
      "action": "execute_action",
      "response_template": "✅ 正在判读QRS宽度... {asserted_qrs_width}。"
    }
  }
}
