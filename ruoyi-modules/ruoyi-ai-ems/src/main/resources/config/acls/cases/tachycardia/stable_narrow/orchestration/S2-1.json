    "preconditions": {},
    "on_complete": {
      "response_template": "💪 正在执行迷走神经刺激，操作状态：{operation_status}。",
      "transition_event": "S2-1_DONE"
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "💪 正在执行 {procedure}，操作状态：{operation_status}。"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 迷走神经刺激状态：{operation_status}。"
    }
  }
