{
  "intent_code": "S2-1",
  "act_type": "发令性指令",
  "name_cn": "迷走神经刺激执行",
  "description_cn": "指导患者进行Valsalva动作或颈动脉窦按摩等迷走神经刺激方法",
  "keywords": ["做Valsalva", "屏气用力", "按摩颈动脉窦"],
  "pattern_hints": ["做Valsalva动作", "使劲屏气"],
  "examples": [
    "做Valsalva动作憋住气用力鼓肚子",
    "让他使劲屏气",
    "按摩颈动脉窦确认无杂音后"
  ],
  "standard_script": "做Valsalva动作，深吸气后屏住用力；确认无颈动脉杂音后按摩颈动脉窦。",
