{
  "intent_code": "S2-4",
  "act_type": "发令性指令",
  "name_cn": "生理盐水快速冲管指令",
  "description_cn": "在腺苷推注后立即快速推注20ml生理盐水，确保药物快速进入中心循环",
  "keywords": ["盐水冲管", "快速冲管", "冲管快"],
  "pattern_hints": ["马上推盐水", "冲管"],
  "examples": [
    "马上推20毫升盐水冲管",
    "快速冲管生理盐水20毫升",
    "冲管快"
  ],
  "standard_script": "立即快速推注20ml生理盐水冲管。",
  "extraction": {
    "target_params": ["drug", "dose", "operation_status"],
    "rules": {
      "drug": { "type": "string", "static": "saline" },
      "dose": { "type": "string", "source": "numeric_value", "unit": "ml" },
      "operation_status": {
        "type": "string",
        "enum": ["done", "start"]
      }
    }
  },
  "execution": {
    "type": "action_chain",
    "steps": [
      { "step_id": "flush_line", "ref_atomic": "FLUSH_LINE", "duty": "IV_MED" }
    ],
    "preconditions": {},
    "on_complete": {
      "response_template": "💉 {drug} {dose} 冲管完成。"
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "💉 正在快速推注 {dose} {drug}。"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 冲管状态：{operation_status}。"
    }
  }
}
