{
  "intent_code": "G3-3",
  "act_type": "发令性指令",
  "name_cn": "建立静脉或骨内通路",
  "description_cn": "建立静脉留置针或骨内通路，确保后续给药途径",
  "keywords": ["建立静脉通道", "留置针", "骨内通路"],
  "pattern_hints": ["打上留置针", "准备骨内"],
  "examples": [
    "建立静脉通道",
    "打上留置针接上生理盐水",
    "准备骨内通路"
  ],
  "standard_script": "建立一条大号静脉通道，接生理盐水；如困难准备骨内通路。",
  "extraction": {
    "target_params": ["accessType"],
    "rules": {
      "accessType": {
        "type": "string",
        "enum": ["IV", "IO"]
      }
    }
  },
  "execution": {
    "type": "action_chain",
    "steps": [
      { "step_id": "iv_access", "ref_atomic": "ACCESS_ESTABLISH", "duty": "IV_MED" }
    ],
    "preconditions": {},
    "on_complete": {
      "response_template": "💉 {accessType} 通路已建立，接上生理盐水。"
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "💉 {accessType} 通路已建立，接上生理盐水。"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 {accessType} 通路已建立。"
    }
  }
}
