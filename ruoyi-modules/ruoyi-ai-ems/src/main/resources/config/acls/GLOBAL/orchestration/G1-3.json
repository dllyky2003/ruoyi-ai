      },
      "actionStatus": {
        "type": "string",
        "enum": ["check", "confirmed", "mitigated"]
      }
    }
  },
  "execution": {
    "type": "query",
    "response_template": "🔍 环境安全检查完毕，未发现明显危险因素。",
    "data_source": "context"
  },
  "pragmatic_handlers": {
    "探查性询问": {
      "action": "query_context",
      "response_template": "🔍 环境安全检查完毕，未发现明显危险因素。"
    }
  }
}
