{
  "intent_code": "G2-4",
  "act_type": "发令性指令",
  "name_cn": "请求专家会诊",
  "description_cn": "当诊断不明确或病情复杂时，请求专家会诊支援",
  "keywords": ["心内科会诊", "电生理医生", "专家支援"],
  "pattern_hints": ["呼叫会诊", "请专家来看"],
  "examples": [
    "呼叫心内科会诊",
    "请电生理医生过来看一下",
    "联系上级医院准备转运",
    "这个情况复杂请专家支援"
  ],
  "standard_script": "呼叫心内科会诊，患者心律不明确，需要专家支援。",
  "extraction": {
    "target_params": ["consultType"],
    "rules": {
      "consultType": {
        "type": "string",
        "enum": ["cardiology", "electrophysiology", "critical_care", "general"]
      }
    }
  },
  "execution": {
    "type": "action_chain",
    "steps": [
      { "step_id": "consult", "ref_atomic": "CONSULT", "duty": "TEAM_LEADER" }
    ],
    "preconditions": {},
    "on_complete": {
      "response_template": "👨‍⚕️ 已呼叫 {consultType} 专家会诊，等待支援。",
      "transition_event": null
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "👨‍⚕️ 已呼叫 {consultType} 专家会诊，等待支援。"
    }
  }
}
