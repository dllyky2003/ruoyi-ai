{
  "intent_code": "G4-1",
  "act_type": "探查性询问",
  "name_cn": "询问或报告血压",
  "description_cn": "获取或报告患者的收缩压和舒张压数值",
  "keywords": ["血压多少", "收缩压", "舒张压"],
  "pattern_hints": ["血压稳定吗", "再量一次血压"],
  "examples": [
    "血压多少",
    "收缩压120舒张压80",
    "再量一次血压",
    "血压稳定吗"
  ],
  "standard_script": "血压多少？收缩压和舒张压分别是多少？",
  "extraction": {
    "target_params": ["systolic_bp", "diastolic_bp"],
    "rules": {
      "systolic_bp": { "type": "integer" },
      "diastolic_bp": { "type": "integer" }
    }
  },
  "execution": {
    "type": "atomic",
    "response_template": "📊 血压 {systolic_bp}/{diastolic_bp} mmHg。",
    "requires_state_transition": false
  },
  "pragmatic_handlers": {
    "探查性询问": {
      "action": "execute_action",
      "response_template": "📊 血压 {systolic_bp}/{diastolic_bp} mmHg。"
    },
    "发令性指令": {
      "action": "execute_action",
      "response_template": "📊 正在测量血压... {systolic_bp}/{diastolic_bp} mmHg。"
    }
  }
}
