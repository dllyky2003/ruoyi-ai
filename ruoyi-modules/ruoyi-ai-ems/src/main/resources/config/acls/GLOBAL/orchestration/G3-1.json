{
  "intent_code": "G3-1",
  "act_type": "发令性指令",
  "name_cn": "开机或监护模式设置",
  "description_cn": "开启除颤仪或监护仪，并将其设置为监护或除颤模式",
  "keywords": ["打开除颤仪", "监护模式", "手动除颤模式"],
  "pattern_hints": ["调到监护模式", "启动血氧监测"],
  "examples": [
    "打开除颤仪调到监护模式",
    "启动血氧饱和度监测",
    "把机器调到手动除颤模式"
  ],
  "standard_script": "打开除颤仪，调至监护模式，连接血氧饱和度监测。",
  "extraction": {
    "target_params": ["mode"],
    "rules": {
      "mode": {
        "type": "string",
        "enum": ["monitor", "defib", "manual"]
      }
    }
  },
  "execution": {
    "type": "action_chain",
    "steps": [
      { "step_id": "device_setup", "ref_atomic": "DEVICE_SETUP", "duty": "MONITOR_DEFIB" }
    ],
    "preconditions": {},
    "on_complete": {
      "response_template": "💻 监护/除颤仪已打开，切换至 {mode} 模式。"
    }
  },
  "pragmatic_handlers": {
    "发令性指令": {
      "action": "advance_chain",
      "response_template": "💻 已打开监护/除颤仪，切换至 {mode} 模式。"
    },
    "探查性询问": {
      "action": "query_step_status",
      "response_template": "📋 设备已开机，当前模式：{mode}。"
    }
  }
}
