{
  "intent_code": "G4-2",
  "act_type": "探查性询问",
  "name_cn": "询问或报告心率",
  "description_cn": "获取或报告患者的当前心率数值",
  "keywords": ["心率多少", "心率数值", "监护仪心率"],
  "pattern_hints": ["现在心率多少", "报一下心率"],
  "examples": [
    "心率现在多少",
    "心率120次分",
    "监护仪上心率多少",
    "报一下心率"
  ],
  "standard_script": "现在心率多少？监护仪显示多少？",
  "extraction": {
    "target_params": ["heart_rate"],
    "rules": {
      "heart_rate": { "type": "integer" }
    }
  },
  "execution": {
    "type": "atomic",
    "response_template": "💓 心率 {heart_rate} 次/分。",
    "requires_state_transition": false
  },
  "pragmatic_handlers": {
    "探查性询问": {
      "action": "execute_action",
      "response_template": "💓 心率 {heart_rate} 次/分。"
    },
    "发令性指令": {
      "action": "execute_action",
      "response_template": "💓 正在测量心率... {heart_rate} 次/分。"
    }
  }
}
