    "exact_standard": {
      "description": "精确匹配：ASR 输出标准表述",
      "cases": [
        {"input": "检查呼吸", "expect_any": ["IA_004_check_breathing", "IA_047_check_breathing_cpr"], "note": "标准表述，可能命中两个 intent"},
