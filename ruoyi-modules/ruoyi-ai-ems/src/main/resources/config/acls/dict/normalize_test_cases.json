        {"input": "靠近", "expect_any": ["IA_001_approach_patient"]}
      ]
    },

    "pinyin_homophone": {
      "description": "拼音匹配：同音字替换",
      "cases": [
        {"input": "呼息", "expect_any": ["IA_004_check_breathing", "IA_047_check_breathing_cpr"], "note": "呼息 → 呼吸"},
        {"input": "摸卖", "expect_any": ["IA_003_check_pulse"], "note": "摸卖 → 摸脉"},
        {"input": "心绿", "expect_any": ["IA_010_check_heart_rate"], "note": "心绿 → 心率"},
