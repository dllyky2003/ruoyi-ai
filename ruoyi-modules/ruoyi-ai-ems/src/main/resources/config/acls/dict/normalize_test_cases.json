        {"input": "放电", "expect_any": ["IA_056_administer_shock_aed"]},
        {"input": "吹气", "expect_any": ["IA_059_ventilate_patient"]},
        {"input": "喝酒", "expect_any": ["IA_008_inquire_substance_use"]},
        {"input": "笑一笑", "expect_any": ["IA_019_face_droop_check"]},
        {"input": "做心电图", "expect_any": ["IA_043_obtain_ecg_recording"]},
        {"input": "上担架", "expect_any": ["IA_063_load_patient_to_stretcher"]},
        {"input": "看意识", "expect_any": ["IA_017_check_ao"]}
      ]
