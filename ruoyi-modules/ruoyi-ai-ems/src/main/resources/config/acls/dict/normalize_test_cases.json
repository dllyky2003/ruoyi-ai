    "fuzzy_edit": {
      "description": "编辑距离：错字/多字/少字",
      "cases": [
        {"input": "摸脉博", "expect_any": ["IA_003_check_pulse"], "note": "多一字"},
        {"input": "心率次", "expect_any": ["IA_010_check_heart_rate"], "note": "少一字"},
        {"input": "血氧气", "expect_any": ["IA_011_check_oxygen_saturation"], "note": "多一字"},
        {"input": "心电图记", "expect_any": ["IA_043_obtain_ecg_recording"], "note": "少一字"},
        {"input": "输液器", "expect_any": [], "note": "无关，不应高分命中"}
      ]
    },

    "clause_with_punct": {
      "description": "分句 + 剥标点",
      "cases": [
        {"input": "快点！看他有没有呼吸。", "expect_any": ["IA_004_check_breathing", "IA_047_check_breathing_cpr"]},
        {"input": "先看反应，再摸脉。", "expect_any": ["IA_002_check_responsiveness", "IA_003_check_pulse"]},
        {"input": "看看瞳孔对光，还有脉搏？", "expect_any": ["IA_015_check_perrl", "IA_003_check_pulse"]},
        {"input": "叫一下他；测一下血氧。", "expect_any": ["IA_002_check_responsiveness", "IA_011_check_oxygen_saturation"]},
        {"input": "有没有呼吸？有没有心跳？", "expect_any": ["IA_004_check_breathing", "IA_010_check_heart_rate"]}
      ]
    },

    "full_width_punct": {
      "description": "全角标点 + 全角字母",
      "cases": [
        {"input": "看ＡＥＤ在哪里", "expect_any": ["IA_050_request_aed"], "note": "全角 AED"},
        {"input": "测一下血氧！", "expect_any": ["IA_011_check_oxygen_saturation"]},
        {"input": "检查心率。", "expect_any": ["IA_010_check_heart_rate"]},
        {"input": "（有没有呼吸）", "expect_any": ["IA_004_check_breathing", "IA_047_check_breathing_cpr"], "note": "括号包裹"}
      ]
    },

    "multi_intent_ambiguity": {
      "description": "一个输入命中多个 intent，都应返回",
      "cases": [
        {"input": "检查呼吸", "expect_all": ["IA_004_check_breathing", "IA_047_check_breathing_cpr"], "note": "非 CPR 和 CPR 中检查呼吸共用表面"},
        {"input": "看心电", "expect_all": ["IA_043_obtain_ecg_recording", "IA_044_interpret_and_report"], "note": "看心电可能是记录也可能是判读"}
      ]
    },

    "negative": {
      "description": "无关文本，不应高分命中",
      "cases": [
        {"input": "今天天气不错", "expect_any": []},
        {"input": "我家住在三楼", "expect_any": []},
        {"input": "嗯好的", "expect_any": []},
