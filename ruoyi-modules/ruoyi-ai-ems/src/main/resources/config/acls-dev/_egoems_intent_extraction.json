{
  "IA_001_approach_patient": {
    "method": "llm",
    "target_params": ["process.environmentSafe"],
    "rules": {},
    "llm_prompt": "提取现场安全状态，输出'安全'或'不安全'。",
    "override_instruction": "keystep_candidates=[\"approach_patient\"]"
  },
  "IA_002_check_responsiveness": {
    "method": "llm",
    "target_params": ["phys.consciousness"],
    "rules": {},
    "llm_prompt": "提取患者对言语或刺激有无反应，输出'有反应'或'无反应'。",
    "override_instruction": "keystep_candidates=[\"check_responsiveness\"]"
  },
  "IA_003_check_pulse": {
    "method": "llm",
    "target_params": ["phys.hasPulse"],
    "rules": {},
    "llm_prompt": "提取有无脉搏，输出'有脉搏'或'无脉搏'。",
    "override_instruction": "keystep_candidates=[\"check_pulse\"]"
  },
  "IA_004_check_breathing": {
    "method": "llm",
    "target_params": ["phys.respiratoryRate"],
    "rules": {},
    "llm_prompt": "提取呼吸状态，输出'有呼吸'、'无呼吸'或具体的呼吸频率数值。",
    "override_instruction": "keystep_candidates=[\"check_breathing\"]"
  },
  "IA_005_review_medications": {
    "method": "llm",
    "target_params": ["clinical.medicationList"],
    "rules": {},
    "llm_prompt": "提取患者当前正在使用的药物名称列表，以逗号分隔。",
    "override_instruction": "keystep_candidates=[\"review_medications\"]"
  },
  "IA_006_inquire_medication_anticoagulants": {
    "method": "llm",
    "target_params": ["clinical.medicationList"],
    "rules": {},
    "llm_prompt": "提取抗凝药物使用情况，列出具体的抗凝药名称（如华法林、利伐沙班等），若无则输出'无'。",
    "override_instruction": "keystep_candidates=[\"inquire_medication_anticoagulants\"]"
  },
  "IA_007_inquire_hpi_and_pmh": {
    "method": "llm",
    "target_params": ["clinical.pastMedicalHistory"],
    "rules": {},
