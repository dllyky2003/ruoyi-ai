  },
  "IA_009_check_blood_pressure": {
    "method": "regex",
    "target_params": ["phys.systolicBp", "phys.diastolicBp"],
    "rules": {
      "pattern": "(\\d+)\\s*[/-]\\s*(\\d+)"
    },
    "llm_prompt": "",
    "override_instruction": "keystep_candidates=[\"check_blood_pressure\"]"
  },
  "IA_010_check_heart_rate": {
    "method": "regex",
    "target_params": ["phys.heartRate"],
    "rules": {
      "pattern": "(\\d+)\\s*(?:次/分|bpm)?"
    },
    "llm_prompt": "",
    "override_instruction": "keystep_candidates=[\"check_heart_rate\"]"
  },
  "IA_011_check_oxygen_saturation": {
    "method": "regex",
    "target_params": ["phys.spo2"],
    "rules": {
      "pattern": "(\\d+)\\s*%?"
    },
    "llm_prompt": "",
    "override_instruction": "keystep_candidates=[\"check_oxygen_saturation\"]"
  },
  "IA_012_check_respiratory_rate": {
    "method": "regex",
    "target_params": ["phys.respiratoryRate"],
    "rules": {
      "pattern": "(\\d+)\\s*(?:次/分| breaths)?"
