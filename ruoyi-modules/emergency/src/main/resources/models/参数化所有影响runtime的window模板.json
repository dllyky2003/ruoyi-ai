    {
      "caseTypeId": "acls_scene_ohca_vf_pvt",
      "zhSummary": "无脉VF/PVT：以除颤/复律为核心，在阶段内完成除颤并触发再评估。",
      "resources": {
        "prerequisites": [
          {
            "prereqId": "prereq_ohca_base_start",
            "zhExplain": "识别为院外心脏骤停场景，并允许进入VF/PVT规则分流。",
            "semanticCondition": {
              "allOf": [
                { "pulseStatus": "none" },
                { "cardiacArrestSubclass": "vf_pvt" },
                {
                  "runtime": {
                    "flag": "initialRhythmClassified",
                    "op": "eq",
                    "value": true
                  }
                }
              ],
              "anyOf": [],
              "metaRef": { "source": "caseType", "caseTypeId": "acls_scene_ohca_vf_pvt" },
              "notes": "院前/基础分流 + 初始节律已能被归类"
            }
          }
        ]
      },
      "stages": {
        "phases": [
          {
            "phaseId": "phase_primary_intervention",
            "rules": [
              {
                "ruleId": "rule_defib_required_and_recorded",
                "zhExplain": "在窗口内完成至少一次除颤动作并记录证据。",
                "condition": {
                  "allOf": [
                    { "cardiacArrestSubclass": "vf_pvt" },
                    {
                      "runtime": {
                        "flag": "defibCompletedInWindow",
