                        "value": true,
                        "windowRef": {
                          "anchor": "runtimeAnchors.cycleStartTs",
                          "durationRef": { "meta": "timeWindow" }
                        }
                      }
                    }
                  ],
                  "anyOf": [],
                  "metaRef": { "source": "caseType", "caseTypeId": "acls_scene_ohca_vf_pvt" },
                  "notes": "用窗口聚合布尔证据判断"
                }
              }
            ]
          },
          {
            "phaseId": "phase_reassessment_cycle",
            "rules": [
              {
                "ruleId": "rule_reassessment_required_in_window",
                "zhExplain": "在窗口内完成节律再评估并形成可用于下一步决策的证据。",
                "condition": {
                  "allOf": [
                    { "cardiacArrestSubclass": "vf_pvt" },
                    {
                      "runtime": {
                        "flag": "rhythmReassessedInWindow",
                        "op": "eq",
                        "value": true,
                        "windowRef": {
                          "anchor": "runtimeAnchors.cycleStartTs",
                          "durationRef": { "meta": "timeWindow" }
                        }
                      }
                    }
                  ],
                  "anyOf": [],
                  "metaRef": { "source": "caseType", "caseTypeId": "acls_scene_ohca_vf_pvt" },
